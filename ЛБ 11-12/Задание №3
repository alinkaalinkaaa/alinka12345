def gcd(a, b):
    """
    Находит наибольший общий делитель двух чисел рекурсивно
    """
    if b == 0:
        return abs(a)
    else:
        return gcd(b, a % b)

# Пример использования
print("Вариант 3 - НОД двух чисел:")
print(f"НОД(48, 18) = {gcd(48, 18)}")
print(f"НОД(1071, 462) = {gcd(1071, 462)}")
print(f"НОД(17, 13) = {gcd(17, 13)}")
print()
